{
  "name": "svs-experience-v21-github-pages",
  "version": "21.0.0",
  "private": true,
  "description": "SVS website with fullscreen aerial campus video, clean V21 hero, three-device responsive layout and GitHub Pages CI/CD.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node tools/server.cjs dev",
    "start": "node tools/server.cjs dev",
    "build": "node tools/build.cjs",
    "preview": "node tools/server.cjs preview",
    "test": "node tools/test.cjs && node tools/smoke.cjs && node tools/verify-v21.cjs",
    "desktop:setup": "npm install --no-save electron@36.9.5 electron-builder@26.0.12",
    "desktop": "electron .",
    "desktop:package": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "in.svs.experience.preview.v21",
    "productName": "SVS Experience V21 GitHub Pages",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "app.js",
      "style.css",
      "experience.css",
      "precision.css",
      "v17.css",
      "v17.js",
      "assets/**/*",
      "client-media/**/*",
      "electron/**/*",
      "package.json",
      "v18.css",
      "v18.js",
      "v19.css",
      "v19.js"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SVS_Experience_V21_Portable_${arch}.exe"
    }
  }
}
